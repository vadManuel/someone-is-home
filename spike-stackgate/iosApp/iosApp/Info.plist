<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>StackGate</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- WITHOUT THIS THE WHOLE SPIKE IS MEASURED AGAINST THE WRONG FRAME BUDGET.
	     iOS caps an app at 60 fps on a ProMotion panel unless it opts in here. At 60 Hz the
	     frame interval is 16.7 ms instead of 8.33 ms, every latency number gets twice the
	     budget it should have, and the gate passes for a reason that has nothing to do with
	     the renderer.

	     The key is ...OnPhone. The shorter CADisableMinimumFrameDuration is not a real key
	     and is silently ignored — Compose Multiplatform refuses to start without the correct
	     one, which is the only reason this was caught rather than shipped as a clean pass at
	     half the refresh rate. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- So the results CSVs can be pulled off the device. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Portrait only: the lamp fills the screen, and a rotation mid-run would relayout the
	     surface being measured. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
